---
# Test configuration - copy to group_vars/test.yml

# Use a test domain (you'll need to point this to your Linode)
domain: test.conspire-demo.com

# Use a different email for testing
certbot_email: test@your-domain.com

# Standard ports (these work fine)
conspire_port: "8443"
landing_port: "443"

# Standard paths
conspire_config_dir: /opt/conspire
landing_web_root: /var/www/test.conspire-demo.com

# Test branding
site_title: "Conspire Test Instance"
site_tagline: "Testing secure anonymous chat"

# Test vendor configuration (can use different branch)
vendor:
  site_content:
    enabled: true
    name: "conspire-site"
    repo: "git@github.com:stonematt/conspire-site.git"
    branch: "main"                    # Test environment can use main branch
    local_path: "vendor/conspire-site"
    destination: "{{ landing_web_root }}/"
    owner: "caddy"
    group: "caddy"